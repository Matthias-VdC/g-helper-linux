<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GHelper.Linux.UI.Controls"
        x:Class="GHelper.Linux.UI.Views.FansWindow"
        Title="Fans &amp; Power"
        Width="700"
        Height="840"
        MinWidth="500"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C"
        Icon="avares://ghelper/UI/Assets/standard.ico">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0" Classes="panel-header" Margin="10,10,10,5">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="headerFanCurves" Classes="header" Text="Fan Curves" FontSize="14" />
                    <TextBlock x:Name="labelMode" Classes="label-dim"
                               Text="Mode: Balanced" />
                    <TextBlock x:Name="labelSensors" Classes="label-dim"
                               Text="" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="buttonMonitor" Classes="ghelper"
                        Margin="4,0" Height="30"
                        Click="ButtonMonitor_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <controls:Icon IconName="bolt" Width="14" Height="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="labelMonitorButton" Text="Monitor" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" x:Name="buttonApplyFans" Classes="ghelper"
                        Content="Apply" Margin="4,0"
                        Click="ButtonApplyFans_Click" />
                <Button Grid.Column="3" x:Name="buttonReset" Classes="ghelper"
                        Content="Reset" Margin="4,0"
                        Click="ButtonReset_Click" />
                <Button Grid.Column="4" x:Name="buttonDisable" Classes="ghelper"
                        Content="Disable" Margin="4,0"
                        Click="ButtonDisable_Click" />
                <CheckBox Grid.Column="5" x:Name="checkApplyFans"
                          Content="Auto-apply" Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsCheckedChanged="CheckApplyFans_Changed" />
            </Grid>
        </Border>

        <!-- CHARTS -->
        <Grid x:Name="chartGrid" Grid.Row="1" Margin="10,5" RowDefinitions="*,*,Auto" MinHeight="580">
            <!-- CPU Fan Chart -->
            <controls:FanCurveChart x:Name="chartCPU"
                                     Grid.Row="0"
                                     Margin="0,0,0,5"
                                     FanLabel="CPU Fan"
                                     LineColor="#3AAEEF" />

            <!-- GPU Fan Chart -->
            <controls:FanCurveChart x:Name="chartGPU"
                                     Grid.Row="1"
                                     Margin="0,5,0,0"
                                     FanLabel="GPU Fan"
                                     LineColor="#FF2020" />

            <!-- Mid Fan Chart (hidden by default, shown when mid fan detected) -->
            <controls:FanCurveChart x:Name="chartMid"
                                     Grid.Row="2"
                                     Margin="0,5,0,0"
                                     FanLabel="Mid Fan"
                                     LineColor="#44DD44"
                                     IsVisible="False" />
        </Grid>

        <!-- POWER LIMITS -->
        <!-- Advanced: per-mode shell hook + power-limit reapply timer. -->
        <Border Grid.Row="2" Classes="panel" Margin="10,0,10,10">
            <StackPanel>
                <TextBlock x:Name="headerAdvanced" Classes="header" Text="Advanced" Margin="0,0,0,4" />

                <!-- Mode shell command -->
                <Grid ColumnDefinitions="120,*" Margin="0,4">
                    <TextBlock Grid.Column="0" x:Name="labelModeCmd" Text="Run on switch:"
                               Classes="label-dim" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="textModeCommand"
                             FontFamily="monospace"
                             TextChanged="TextModeCommand_TextChanged" />
                </Grid>
                <TextBlock x:Name="labelModeCmdHint" Classes="label-dim" FontSize="10"
                           TextWrapping="Wrap" Margin="120,0,0,4"
                           Text="Runs via /bin/sh -c after every mode switch (manual + auto AC/DC). Per-mode; switch modes to edit each." />

                <!-- Reapply timer -->
                <Grid ColumnDefinitions="120,Auto,Auto,*" Margin="0,8,0,4">
                    <TextBlock Grid.Column="0" x:Name="labelReapply" Text="Reapply power:"
                               Classes="label-dim" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" x:Name="numReapplyTime"
                                   Minimum="0" Maximum="600" Increment="5" Value="0"
                                   Width="120"
                                   ValueChanged="NumReapplyTime_ValueChanged" />
                    <TextBlock Grid.Column="2" x:Name="labelReapplyUnit" Text="seconds (0 = off)"
                               Classes="label-dim" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="labelReapplyHint" Classes="label-dim" FontSize="10"
                           TextWrapping="Wrap" Margin="120,0,0,0"
                           Text="Re-write CPU/GPU power limits at this interval. Useful when BIOS clobbers PPT." />
            </StackPanel>
        </Border>

    </Grid>
    </ScrollViewer>

</Window>
